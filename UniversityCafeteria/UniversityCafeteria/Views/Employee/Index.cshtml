@model List<Employee>

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0">Employees</h4>

            <a asp-action="Create"
               asp-controller="Employee"
               class="btn btn-primary">
                + Create Employee
            </a>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Position</th>
                            <th>Salary</th>
                            <th>Hire Date</th>
                            <th>Orders</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td>@employee.Id</td>
                                <td>@employee.FullName</td>
                                <td>@employee.Email</td>
                                <td>@employee.Phone</td>
                                <td>@employee.Position</td>
                                <td>@employee.Salary</td>
                                <td>@employee.HireDate</td>
                                <td>@employee.orders.Count</td>
                                <td>
                                    <a asp-action="Edit" asp-controller="Employee" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-controller="Employee" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger">Delete</a>    
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>